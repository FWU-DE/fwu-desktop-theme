#!/bin/sh
# fwu-theme – FWU-Theme für GNOME und Omarchy einrichten.
#
#   fwu-theme apply [light|dark] [--wallpaper MOTIV] [--flatpak]
#   fwu-theme wallpaper [MOTIV|next|list]
#   fwu-theme omarchy [--force]
#   fwu-theme status
#   fwu-theme reset
#
# Everything follows GNOME's dark-mode switch: `apply` turns the theme on and
# starts a watcher (also started at login by the autostart entry) that swaps
# the light and dark parts whenever the switch changes. Needs only a POSIX
# shell and gsettings, which every GNOME has.

set -u

DATA=
for d in "${FWU_THEME_DATA:-}" "${XDG_DATA_HOME:-$HOME/.local/share}/fwu-desktop-theme" \
         /usr/local/share/fwu-desktop-theme /usr/share/fwu-desktop-theme; do
  if [ -n "$d" ] && [ -f "$d/gnome/wallpapers.tsv" ]; then DATA=$d; break; fi
done

CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
LOCAL=${XDG_DATA_HOME:-$HOME/.local/share}
STATE=$CONFIG/fwu-desktop-theme
ENABLED=$STATE/enabled
PIDFILE=$STATE/watch.pid
TAB=$(printf '\t')

INTERFACE=org.gnome.desktop.interface
BACKGROUND=org.gnome.desktop.background
SCREENSAVER=org.gnome.desktop.screensaver
USER_THEME=org.gnome.shell.extensions.user-theme
USER_THEME_EXT=user-theme@gnome-shell-extensions.gcampax.github.com
BEGIN='/* >>> fwu-desktop-theme >>> (verwaltet von fwu-theme, nicht bearbeiten) */'
END='/* <<< fwu-desktop-theme <<< */'

say() { echo "fwu-theme: $*"; }
die() { say "$*" >&2; exit 1; }

usage() { sed -n '2,9s/^# \{0,1\}//p' "$0"; }

need_data() { [ -n "$DATA" ] || die "Theme-Dateien nicht gefunden – erst ./install.sh ausführen."; }

gget() { gsettings get "$1" "$2" 2>/dev/null | sed "s/^'//; s/'\$//"; }
gset() { gsettings set "$@" >/dev/null 2>&1; }
greset() { gsettings reset "$1" "$2" >/dev/null 2>&1; }

mode() { [ "$(gget $INTERFACE color-scheme)" = prefer-dark ] && echo dark || echo light; }
shell_theme() { [ "$1" = dark ] && echo FWU-Dark || echo FWU; }

# --- gtk.css: our block goes first, because @import must come first ---------

set_block() { # FILE [BODY]
  file=$1 body=${2:-}
  rest=
  [ -f "$file" ] && rest=$(awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$file")
  if [ -n "$body" ]; then
    mkdir -p "$(dirname "$file")"
    { printf '%s\n%s\n%s\n' "$BEGIN" "$body" "$END"; [ -n "$rest" ] && printf '%s\n' "$rest"; } > "$file"
  elif [ -n "$rest" ]; then
    printf '%s\n' "$rest" > "$file"
  else
    rm -f "$file"
  fi
}

# --- shell theme ---------------------------------------------------------------

user_theme_installed() { gnome-extensions info $USER_THEME_EXT >/dev/null 2>&1; }

user_theme_set() {
  if gsettings list-keys $USER_THEME >/dev/null 2>&1; then
    gset $USER_THEME name "$1"; return
  fi
  for base in "$LOCAL/gnome-shell/extensions" /usr/share/gnome-shell/extensions; do
    if [ -d "$base/$USER_THEME_EXT/schemas" ]; then
      gsettings --schemadir "$base/$USER_THEME_EXT/schemas" set $USER_THEME name "$1" >/dev/null 2>&1
      return
    fi
  done
}

# --- icons ---------------------------------------------------------------------

icon_theme() { # MODE -> installed icon theme name, or nothing
  name=$(awk -F"$TAB" -v m="$1" '$1==m{print $2}' "$DATA/gnome/icons")
  for root in "$LOCAL/icons" "$HOME/.icons" /usr/share/icons; do
    [ -n "$name" ] && [ -d "$root/$name" ] && { echo "$name"; return; }
  done
  base=${name%-dark}
  for root in "$LOCAL/icons" "$HOME/.icons" /usr/share/icons; do
    [ -n "$base" ] && [ -d "$root/$base" ] && { echo "$base"; return; }
  done
}

# --- wallpapers ------------------------------------------------------------------

wallpaper_row() { # MOTIF -> tsv row
  awk -F"$TAB" -v m="$1" '$1==m' "$DATA/gnome/wallpapers.tsv"
}

current_motif() {
  uri=$(gget $BACKGROUND picture-uri)
  while IFS=$TAB read -r m _title light dark; do
    case $uri in *"/themes/$light"|*"/themes/$dark") echo "$m"; return ;; esac
  done < "$DATA/gnome/wallpapers.tsv"
}

set_wallpaper() { # MOTIF
  row=$(wallpaper_row "$1")
  [ -n "$row" ] || die "unbekanntes Motiv: $1 (siehe: fwu-theme wallpaper list)"
  light=$(echo "$row" | cut -f3) dark=$(echo "$row" | cut -f4)
  gset $BACKGROUND picture-uri "file://$DATA/themes/$light"
  gset $BACKGROUND picture-uri-dark "file://$DATA/themes/$dark"
  gset $BACKGROUND picture-options zoom
  gset $SCREENSAVER picture-uri "file://$DATA/themes/$dark"
  say "Hintergrund: $(echo "$row" | cut -f2)"
}

# --- sync / watch ------------------------------------------------------------------

sync() {
  m=$(mode)
  for v in gtk-4.0 gtk-3.0; do
    mkdir -p "$CONFIG/$v"
    cp "$DATA/gnome/$v/$m.css" "$CONFIG/$v/fwu-desktop-theme.css"
    set_block "$CONFIG/$v/gtk.css" '@import url("fwu-desktop-theme.css");'
  done
  icons=$(icon_theme "$m")
  [ -n "$icons" ] && gset $INTERFACE icon-theme "$icons"
  user_theme_set "$(shell_theme "$m")"
}

watcher_pid() {
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

cmd_watch() {
  [ -f "$ENABLED" ] || exit 0
  need_data
  watcher_pid >/dev/null && exit 0
  echo $$ > "$PIDFILE"
  sync
  last=$(mode)
  gsettings monitor $INTERFACE color-scheme | while read -r _; do
    [ -f "$ENABLED" ] || break
    now=$(mode)
    [ "$now" != "$last" ] && { sync; last=$now; }
  done
}

start_watcher() {
  watcher_pid >/dev/null && return
  nohup "$0" watch >/dev/null 2>&1 &
}

# --- commands ----------------------------------------------------------------------

cmd_apply() {
  need_data
  want= motif= flatpak=
  while [ $# -gt 0 ]; do
    case $1 in
      light|dark) want=$1 ;;
      --wallpaper) motif=${2:-}; shift ;;
      --wallpaper=*) motif=${1#*=} ;;
      --flatpak) flatpak=1 ;;
      *) die "unbekannte Option: $1" ;;
    esac
    shift
  done
  case $want in
    dark) gset $INTERFACE color-scheme prefer-dark ;;
    light) gset $INTERFACE color-scheme default ;;
  esac
  gset $INTERFACE accent-color orange   # for apps that skip gtk.css
  [ -n "$motif" ] || motif=$(current_motif)
  set_wallpaper "${motif:-fwu-logo}"

  mkdir -p "$STATE"
  touch "$ENABLED"
  sync
  start_watcher

  if [ -n "$flatpak" ] && command -v flatpak >/dev/null; then
    flatpak override --user --filesystem=xdg-config/gtk-4.0:ro --filesystem=xdg-config/gtk-3.0:ro
    say "Flatpak-Apps lesen jetzt ebenfalls die FWU-Farben."
  fi

  [ "$(mode)" = dark ] && m=dunkel || m=hell
  say "FWU-Theme aktiv ($m, folgt dem Dunkelmodus-Schalter)."
  if user_theme_installed; then
    gnome-extensions enable $USER_THEME_EXT >/dev/null 2>&1
  else
    say "Für Leiste und Menüs fehlt die GNOME-Erweiterung »User Themes«:"
    say "  Debian/Ubuntu: sudo apt install gnome-shell-extensions"
    say "  Fedora:        sudo dnf install gnome-shell-extension-user-theme"
    say "  Arch:          sudo pacman -S gnome-shell-extensions"
    say "danach ab- und wieder anmelden und »fwu-theme apply« erneut ausführen."
  fi
  say "Bereits geöffnete Programme übernehmen die Farben nach einem Neustart."
}

cmd_wallpaper() {
  need_data
  arg=${1:-next}
  case $arg in
    list)
      cur=$(current_motif)
      while IFS=$TAB read -r m title _light _dark; do
        [ "$m" = "$cur" ] && mark='*' || mark=' '
        printf '%s %-14s %s\n' "$mark" "$m" "$title"
      done < "$DATA/gnome/wallpapers.tsv" ;;
    next)
      cur=$(current_motif)
      next=$(awk -F"$TAB" -v c="$cur" 'found{print $1; exit} $1==c{found=1}' "$DATA/gnome/wallpapers.tsv")
      [ -n "$next" ] || next=$(head -n1 "$DATA/gnome/wallpapers.tsv" | cut -f1)
      set_wallpaper "$next" ;;
    *) set_wallpaper "$arg" ;;
  esac
}

cmd_omarchy() {
  need_data
  dest=$CONFIG/omarchy/themes
  mkdir -p "$dest"
  for src in "$DATA"/themes/*/; do
    src=${src%/} name=$(basename "$src")
    if [ -L "$dest/$name" ]; then
      rm "$dest/$name"
    elif [ -e "$dest/$name" ]; then
      if [ "${1:-}" != --force ]; then
        say "$dest/$name existiert schon – mit »fwu-theme omarchy --force« ersetzen."
        continue
      fi
      rm -rf "$dest/$name"
    fi
    ln -s "$src" "$dest/$name"
    say "Omarchy-Theme $name → $dest/$name"
  done
  say "Aktivieren mit: omarchy theme set fwu   bzw.   omarchy theme set fwu-dark"
}

cmd_status() {
  need_data
  [ -f "$ENABLED" ] && on=ja || on=nein
  pid=$(watcher_pid) && w="läuft (PID $pid)" || w="läuft nicht"
  user_theme_installed && ut=installiert || ut=fehlt
  cur=$(current_motif)
  printf '%-12s %s\n' Daten "$DATA" aktiv "$on" Modus "$(mode)" Watcher "$w" \
    Hintergrund "${cur:-kein FWU-Motiv}" Icons "$(gget $INTERFACE icon-theme)" \
    Akzent "$(gget $INTERFACE accent-color)" "User Themes" "$ut"
}

cmd_reset() {
  rm -f "$ENABLED"
  pid=$(watcher_pid) && kill "$pid" 2>/dev/null
  pkill -f "gsettings monitor $INTERFACE color-scheme" 2>/dev/null
  rm -f "$PIDFILE"
  for v in gtk-4.0 gtk-3.0; do
    set_block "$CONFIG/$v/gtk.css"
    rm -f "$CONFIG/$v/fwu-desktop-theme.css"
  done
  case $(gget $USER_THEME name) in FWU|FWU-Dark) user_theme_set "" ;; esac
  if [ -n "$DATA" ] && [ -n "$(current_motif)" ]; then
    greset $BACKGROUND picture-uri; greset $BACKGROUND picture-uri-dark; greset $SCREENSAVER picture-uri
  fi
  greset $INTERFACE accent-color
  greset $INTERFACE icon-theme
  say "FWU-Theme entfernt (die Dunkelmodus-Einstellung bleibt, wie sie ist)."
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  apply) cmd_apply "$@" ;;
  wallpaper) cmd_wallpaper "$@" ;;
  omarchy) cmd_omarchy "$@" ;;
  status) cmd_status ;;
  reset) cmd_reset ;;
  watch) cmd_watch ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
